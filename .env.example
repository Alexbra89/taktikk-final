# AI-trener (/api/ai). Kopier til .env.local og fyll inn. .env.local committes aldri.
# Bare server-side: ingen av disse skal ha NEXT_PUBLIC_ foran.

# Nøkkel fra openrouter.ai. Sett også en hard forbruksgrense på OpenRouter-kontoen.
OPENROUTER_API_KEY=
# Modell-ID fra openrouter.ai/models, f.eks. en Gemini Flash-modell.
AI_MODEL=
# Kode treneren skriver inn i appen for å få bruke AI-treneren.
AI_ACCESS_CODE=
