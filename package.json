    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.187.0",
    "@vitest/ui": "^4.1.12",
    "autoprefixer": "^10.7.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
