/_skjermbilder/

# next.js
/.next/
/out/

# production
/build

# next-pwa (generated into public/ by npm run build)
/public/sw.js
/public/sw.js.map
/public/workbox-*.js
/public/workbox-*.js.map
/public/worker-*.js
/public/worker-*.js.map
/public/fallback-*.js
/public/fallback-*.js.map

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

docs/supabase-backup-*.csv
artifacts/
